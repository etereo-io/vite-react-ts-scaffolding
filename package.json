{
  "name": "vite-react-ts-scaffolding",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "preupdate": "npx only-allow pnpm",
    "dev": "vite",
    "start": "npm run dev",
    "build": "tsc && vite build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:deps": "npx depcruise src",
    "types:check": "tsc --noEmit",
    "git:pre-commit": "npm run types:check && npm run lint:deps && lint-staged",
    "test:base": "vitest --passWithNoTests",
    "test": "npm run test:coverage",
    "test:ui": "npm run test:base -- --ui",
    "test:run": "npm run test:base -- --run",
    "test:coverage": "npm run test:base -- --run --coverage",
    "verify": "npm run lint:fix && npm run test && npm run build && npm run lint:deps",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "lint-staged": {
    "(src)/**/*.(ts|tsx)": [
      "biome check --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "axios": "^1.13.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "deepmerge-ts": "^7.1.5",
    "i18next": "^25.8.14",
    "i18next-browser-languagedetector": "^8.2.1",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.577.0",
    "query-string": "^9.3.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.1.1",
    "react-hook-form": "^7.71.2",
    "react-i18next": "^16.5.5",
    "react-idle-timer": "^5.7.2",
    "react-router": "^7.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@faker-js/faker": "^10.3.0",
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "dependency-cruiser": "^17.3.8",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.3.2",
    "msw": "^2.12.10",
    "react-remove-attr": "^0.0.6",
    "shadcn": "^3.8.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-checker": "^0.12.0",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.0.18",
    "vitest-sonar-reporter": "^3.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
