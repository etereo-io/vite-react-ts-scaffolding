{
  "name": "vite-react-ts-scaffolding",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "preupdate": "npx only-allow pnpm",
    "dev": "vite",
    "start": "npm run dev",
    "build": "tsc && vite build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:deps": "npx depcruise src",
    "types:check": "tsc --noEmit",
    "git:pre-commit": "npm run types:check && npm run lint:deps && lint-staged",
    "test:base": "vitest --passWithNoTests",
    "test": "npm run test:coverage",
    "test:ui": "npm run test:base -- --ui",
    "test:run": "npm run test:base -- --run",
    "test:coverage": "npm run test:base -- --run --coverage",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "lint-staged": {
    "(src)/**/*.(ts|tsx)": [
      "biome check --write"
    ]
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-query": "^5.83.1",
    "axios": "^1.11.0",
    "clsx": "^2.1.1",
    "deepmerge-ts": "^7.1.5",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "intersection-observer": "^0.12.2",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.535.0",
    "query-string": "^9.2.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^15.6.1",
    "react-router": "^7.7.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.3",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@faker-js/faker": "^9.9.0",
    "@juggle/resize-observer": "^3.4.0",
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-v8": "^3.2.4",
    "dependency-cruiser": "^17.0.0",
    "husky": "^9.1.7",
    "install": "^0.13.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.2",
    "matchmedia-polyfill": "^0.3.2",
    "msw": "^2.10.4",
    "react-remove-attr": "^0.0.6",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vite-plugin-checker": "^0.10.2",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^3.2.4",
    "vitest-sonar-reporter": "^2.0.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
